COMPOSE_PROJECT_NAME=elinea-production
ENVIRONMENT_SLUG=production
DOMAIN=elinea.com.br
ACME_EMAIL=infra@elinea.com.br
HOSTINGER_API_TOKEN=
REGISTRY_NAMESPACE=ghcr.io/xploter13
IMAGE_TAG=production

APP_NAME=Elinea
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.elinea.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=elinea
DB_USERNAME=elinea
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
HORIZON_MAX_PROCESSES=1

FILESYSTEM_DISK=local
CORS_ALLOWED_ORIGINS=https://elinea.com.br,https://admin.elinea.com.br,https://gestao.elinea.com.br
PANEL_URL=https://admin.elinea.com.br
TENANCY_BASE_DOMAIN=elinea.com.br
TENANCY_HEADER=X-Site
TENANCY_DOMAIN_HEADER=X-Store-Domain
API_SETUP_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=contato@elinea.com.br
MAIL_FROM_NAME=Elínea

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=brl
CASHIER_CURRENCY_LOCALE=pt_BR
